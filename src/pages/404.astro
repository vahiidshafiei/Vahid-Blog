---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <div class="wrap">
    <header class="page-title">
      <p class="meta-label">404</p>
      <h1>Nothing at this address.</h1>
      <p>The page may have moved. Try the <a class="link-arrow" href="/posts">archive</a> or press <kbd>Ctrl</kbd> <kbd>K</kbd> to search.</p>
    </header>
  </div>
</Base>
