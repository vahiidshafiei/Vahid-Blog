---
// To add a theme: add tokens in src/styles/global.css and an entry here.
const THEMES = [
  { id: 'obsidian', label: 'Obsidian', colors: ['#08090c', '#8b9bff'] },
  { id: 'ivory', label: 'Ivory', colors: ['#faf7f0', '#a33f24'] },
  { id: 'aurora', label: 'Aurora', colors: ['#050a18', '#4de0ff'] },
  { id: 'graphite', label: 'Graphite', colors: ['#17181a', '#e8a33d'] },
  { id: 'paper', label: 'Paper', colors: ['#f3ecdd', '#2f5d62'] },
];
---

<div class="theme-wrap">
  <button class="nav-btn" id="theme-btn" aria-haspopup="true" aria-expanded="false" aria-controls="theme-pop">
    <span class="sr-only">Choose theme</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" /></svg>
  </button>
  <div class="theme-pop" id="theme-pop" role="radiogroup" aria-label="Theme" hidden>
    <button class="theme-opt" role="radio" aria-checked="false" data-theme-choice="auto">
      <span class="swatch" aria-hidden="true"><i style="background:#08090c"></i><i style="background:#faf7f0"></i></span>
      <span>Auto <small class="meta-label">follows system</small></span>
    </button>
    {THEMES.map((t) => (
      <button class="theme-opt" role="radio" aria-checked="false" data-theme-choice={t.id}>
        <span class="swatch" aria-hidden="true"><i style={`background:${t.colors[0]}`}></i><i style={`background:${t.colors[1]}`}></i></span>
        <span>{t.label}</span>
      </button>
    ))}
  </div>
</div>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-btn')!;
  const pop = document.getElementById('theme-pop')!;
  const opts = [...pop.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
  const mq = matchMedia('(prefers-color-scheme: dark)');

  const resolve = (pref: string) => (pref === 'auto' ? (mq.matches ? 'obsidian' : 'ivory') : pref);

  function apply(pref: string, animate = true) {
    if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('theme-transition');
      setTimeout(() => root.classList.remove('theme-transition'), 400);
    }
    root.dataset.theme = resolve(pref);
    root.dataset.themePref = pref;
    try { localStorage.setItem('theme', pref); } catch {}
    sync();
  }
  function sync() {
    const pref = root.dataset.themePref || 'auto';
    opts.forEach((o) => o.setAttribute('aria-checked', String(o.dataset.themeChoice === pref)));
  }
  function setOpen(open: boolean) {
    pop.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    if (open) (opts.find((o) => o.getAttribute('aria-checked') === 'true') ?? opts[0]).focus();
  }

  sync();
  btn.addEventListener('click', () => setOpen(pop.hidden));
  opts.forEach((o) => o.addEventListener('click', () => { apply(o.dataset.themeChoice!); }));
  document.addEventListener('click', (e) => { if (!pop.hidden && !(e.target as Element).closest('.theme-wrap')) setOpen(false); });
  pop.addEventListener('keydown', (e) => {
    const i = opts.indexOf(document.activeElement as HTMLButtonElement);
    if (e.key === 'Escape') { setOpen(false); btn.focus(); }
    if (e.key === 'ArrowDown') { e.preventDefault(); opts[(i + 1) % opts.length].focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); opts[(i - 1 + opts.length) % opts.length].focus(); }
  });
  mq.addEventListener('change', () => { if ((root.dataset.themePref || 'auto') === 'auto') apply('auto', false); });
</script>
