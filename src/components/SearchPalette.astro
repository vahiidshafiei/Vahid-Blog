---
// Full-text search powered by Pagefind. The index is generated by
// `npm run build` (see package.json), so search works in the built site
// and `npm run preview`, but not in `npm run dev`.
---

<dialog class="palette" id="palette" aria-label="Search">
  <label class="sr-only" for="palette-input">Search posts</label>
  <input id="palette-input" type="search" placeholder="Search posts, tags, text…" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="palette-results" />
  <ul class="palette-results" id="palette-results" role="listbox" aria-label="Results"></ul>
  <div class="palette-foot"><span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></div>
</dialog>

<script>
  const dialog = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('palette-input') as HTMLInputElement;
  const list = document.getElementById('palette-results') as HTMLUListElement;

  type PF = { search: (q: string) => Promise<{ results: { data: () => Promise<PFData> }[] }>; options?: (o: object) => Promise<void> };
  type PFData = { url: string; excerpt: string; meta: { title?: string } };

  let pf: PF | null = null;
  let pfFailed = false;
  let seq = 0;
  let active = -1;

  async function loadPagefind(): Promise<PF | null> {
    if (pf || pfFailed) return pf;
    try {
      const url = '/pagefind/pagefind.js';
      pf = (await import(/* @vite-ignore */ url)) as PF;
    } catch {
      pfFailed = true;
    }
    return pf;
  }

  function message(text: string) {
    list.innerHTML = '';
    const li = document.createElement('li');
    li.className = 'palette-msg';
    li.textContent = text;
    list.append(li);
    active = -1;
  }

  function setActive(i: number) {
    const items = [...list.querySelectorAll<HTMLAnchorElement>('a')];
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((a, n) => a.setAttribute('aria-selected', String(n === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  async function run(q: string) {
    const mine = ++seq;
    if (!q.trim()) return message('Type to search.');
    const engine = await loadPagefind();
    if (!engine) return message('Search index not found. It is created by "npm run build" — it does not exist in dev mode.');
    const res = await engine.search(q);
    if (mine !== seq) return;
    const hits = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    if (mine !== seq) return;
    if (!hits.length) return message(`No results for “${q}”.`);
    list.innerHTML = '';
    hits.forEach((h) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'presentation');
      const a = document.createElement('a');
      a.href = h.url;
      a.setAttribute('role', 'option');
      const t = document.createElement('div');
      t.className = 'r-title';
      t.textContent = h.meta.title ?? h.url;
      const ex = document.createElement('div');
      ex.className = 'r-excerpt';
      ex.innerHTML = h.excerpt; // Pagefind output: text escaped, only <mark> tags added
      a.append(t, ex);
      li.append(a);
      list.append(li);
    });
    setActive(0);
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.select();
    if (!input.value) message('Type to search.');
    loadPagefind();
  }

  document.getElementById('open-search')?.addEventListener('click', open);
  addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dialog.open ? dialog.close() : open(); }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  let timer: number | undefined;
  input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => run(input.value), 120); });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') {
      const a = list.querySelectorAll<HTMLAnchorElement>('a')[active];
      if (a) { e.preventDefault(); location.href = a.href; }
    }
  });
</script>
